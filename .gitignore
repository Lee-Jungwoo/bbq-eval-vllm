# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# macOS
.DS_Store

# Per-run pipeline artifacts (results/runs/<run_id>/).
# Everything in a run directory is bulk regenerable output — requests/instances/
# responses/records.jsonl are ~56MB per run, and the free-generation arm adds more.
# Only the small provenance files are kept in version control.
results/runs/**
!results/runs/*/
!results/runs/*/meta.json
!results/runs/*/summary.json

# Same for the forced-choice (A/B, no-unknown) arm: results/runs_binary/<run_id>/.
results/runs_binary/**
!results/runs_binary/*/
!results/runs_binary/*/meta.json
!results/runs_binary/*/summary.json

# Per-ladder logs (logs/ladder_<timestamp>/, written by scripts/run_ladder*.sh) and
# stray nohup output. vLLM engine logs, tens of MB per ladder; the numbers they
# produced are already captured in the run summaries and the leaderboard exports.
# The one early Qwen2.5 ladder that is kept as serving evidence lives, already
# tracked, under results/serving_logs/.
/logs/
nohup.out
*.out



# python notebooks
*.ipynb
# leaderboard: the SQLite database is a build artifact of src/bbq_eval/publish.py and
# is regenerable from results/runs/. The CSV/JSON exports under
# results/leaderboard/exports/ are small and ARE committed — they are what makes the
# published numbers reviewable without the database.
results/leaderboard/*.sqlite
results/leaderboard/*.sqlite-wal
results/leaderboard/*.sqlite-shm

# Local environment files.
.env
.venv/
