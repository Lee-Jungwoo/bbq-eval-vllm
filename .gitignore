# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# macOS
.DS_Store

# Per-run pipeline artifacts (bbq_pipeline/runs/<run_id>/).
# Everything in a run directory is bulk regenerable output — requests/instances/
# responses/records.jsonl are ~56MB per run, and the free-generation arm adds more.
# Only the small provenance files are kept in version control.
bbq_pipeline/runs/**
!bbq_pipeline/runs/*/
!bbq_pipeline/runs/*/meta.json
!bbq_pipeline/runs/*/summary.json

# Same for the binary (A/B, no-unknown) arm: bbq_pipeline/runs_binary/<run_id>/.
bbq_pipeline/runs_binary/**
!bbq_pipeline/runs_binary/*/
!bbq_pipeline/runs_binary/*/meta.json
!bbq_pipeline/runs_binary/*/summary.json

# Per-ladder logs (bbq_pipeline/logs/ladder_<timestamp>/) and stray nohup output.
# vLLM engine logs, tens of MB per ladder; the numbers they produced are already
# captured in the run summaries and the leaderboard exports.
bbq_pipeline/logs/
nohup.out
*.out



# python notebooks
*.ipynb
# leaderboard: the SQLite database is a build artifact of bbq_pipeline/publish.py and
# is regenerable from bbq_pipeline/runs/. The CSV/JSON exports under
# leaderboard/exports/ are small and ARE committed — they are what makes the
# published numbers reviewable without the 160MB database.
leaderboard/*.sqlite
leaderboard/*.sqlite-wal
leaderboard/*.sqlite-shm
